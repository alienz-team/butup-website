# The storefront runs on built-in seed data without any of these.
NEXT_PUBLIC_SITE_URL="https://putup.store"

# Supabase project (the publishable key is safe in the browser; RLS blocks all Data API access)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Transaction pooler (6543), used by the app at runtime
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=20"
# Session pooler (5432, IPv4) for `prisma db push`. The db.<ref> direct host is IPv6-only.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Admin dashboard (/admin). The secret must be at least 16 random characters.
ADMIN_SESSION_SECRET="generate-with-openssl-rand-hex-32"
ADMIN_EMAIL="admin@putup.store"
ADMIN_PASSWORD="change-me"

# Public contact details (digits only for the WhatsApp number, country code first)
NEXT_PUBLIC_WHATSAPP_NUMBER="218915229703"
NEXT_PUBLIC_FACEBOOK_URL=""

# Vercel Blob token, enables image uploads in the admin dashboard
# Supabase Storage uploads (server only, never NEXT_PUBLIC). Bucket: product-images
SUPABASE_SERVICE_ROLE_KEY=""

BLOB_READ_WRITE_TOKEN=""
