generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
}

model Category {
  id        String     @id @default(cuid())
  nameAr    String
  nameEn    String
  slug      String     @unique
  image     String
  sortOrder Int        @default(0)
  /// Sub-categories (e.g. dresses under clothing) point at their parent.
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Product {
  id            String   @id @default(cuid())
  titleAr       String
  titleEn       String
  slug          String   @unique
  descriptionAr String   @default("")
  descriptionEn String   @default("")
  price         Float
  compareAtPrice Float?
  images        String[]
  /// Variant options shown on the product page.
  sizes         String[]
  /// [{ "ar": "ذهبي", "en": "Gold", "hex": "#C9AA71" }]
  colors        Json     @default("[]")
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  stock         Int      @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([isFeatured, isActive])
}

model Order {
  id            String      @id @default(cuid())
  number        String      @unique
  customerName  String
  customerPhone String
  address       String
  totalAmount   Float
  status        OrderStatus @default(PENDING)
  /// [{ "productId", "slug", "title", "size", "color", "qty", "unitPrice" }]
  orderItems    Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         Role     @default(ADMIN)
  passwordHash String
  createdAt    DateTime @default(now())
}
