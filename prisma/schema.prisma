generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Category {
  slug          String        @id
  nameAr        String
  nameEn        String
  image         String
  sortOrder     Int           @default(0)
  subCategories SubCategory[]
  products      Product[]
}

model SubCategory {
  slug         String    @id
  categorySlug String
  category     Category  @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)
  nameAr       String
  nameEn       String
  sortOrder    Int       @default(0)
  products     Product[]

  @@index([categorySlug])
}

model Product {
  id           String       @id @default(cuid())
  code         String       @unique
  nameAr       String
  nameEn       String
  descAr       String       @default("")
  descEn       String       @default("")
  price        Int
  oldPrice     Int?
  images       String[]
  sizes        String[]
  /// [{ "ar": "ذهبي", "en": "Gold", "hex": "#C9AA71" }]
  colors       Json         @default("[]")
  stock        Int          @default(0)
  featured     Boolean      @default(false)
  active       Boolean      @default(true)
  categorySlug String
  category     Category     @relation(fields: [categorySlug], references: [slug])
  subSlug      String?
  subCategory  SubCategory? @relation(fields: [subSlug], references: [slug])
  orderItems   OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([categorySlug, active])
  @@index([featured, active])
}

model Order {
  id        String      @id @default(cuid())
  number    String      @unique
  status    OrderStatus @default(NEW)
  total     Int
  note      String?
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCode String
  productName String
  size        String?
  color       String?
  qty         Int
  unitPrice   Int

  @@index([orderId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         Role     @default(ADMIN)
  passwordHash String
  createdAt    DateTime @default(now())
}
